<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>{{ resume.contact.full_name or 'Resume' }}</title>
  <style>
    body { font-family: Georgia, 'Times New Roman', serif; font-size: 11pt; color: #111; margin: 36px; max-width: 720px; }
    h1 { font-size: 20pt; margin: 0 0 6px 0; }
    .meta { color: #444; font-size: 10pt; margin-bottom: 16px; }
    h2 { font-size: 12pt; border-bottom: 1px solid #333; margin: 18px 0 8px; text-transform: uppercase; letter-spacing: 0.05em; }
    ul { margin: 4px 0 12px 20px; }
    li { line-height: 1.35; }
    .role { font-weight: bold; }
  </style>
</head>
<body>
  <h1>{{ resume.contact.full_name or 'Candidate' }}</h1>
  <div class="meta">
    {% set bits = [resume.contact.email, resume.contact.phone, resume.contact.location, resume.contact.linkedin_url] | select | list %}
    {{ bits | join(' · ') }}
  </div>
  {% if resume.summary %}
  <h2>Summary</h2>
  <p>{{ resume.summary }}</p>
  {% endif %}
  {% if resume.skills %}
  <h2>Skills</h2>
  <p>{{ resume.skills | join(', ') }}</p>
  {% endif %}
  {% if resume.experience %}
  <h2>Experience</h2>
  {% for exp in resume.experience %}
  <p><span class="role">{{ exp.title }}</span>{% if exp.company %} — {{ exp.company }}{% endif %}
    {% if exp.start_date %} ({{ exp.start_date }}{% if exp.end_date or exp.is_current %} – {{ exp.end_date or 'Present' }}{% endif %}){% endif %}
  </p>
  {% if exp.bullets %}<ul>{% for b in exp.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
  {% endfor %}
  {% endif %}
  {% if resume.education %}
  <h2>Education</h2>
  {% for edu in resume.education %}
  <p>{{ [edu.degree, edu.field_of_study, edu.institution] | select | join(' · ') }}</p>
  {% endfor %}
  {% endif %}
</body>
</html>
