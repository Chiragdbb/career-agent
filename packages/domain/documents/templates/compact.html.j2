<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>{{ resume.contact.full_name or 'Resume' }}</title>
  <style>
    body { font-family: Arial, sans-serif; font-size: 10pt; margin: 32px; line-height: 1.3; }
    h1 { font-size: 16pt; margin-bottom: 4px; }
    h2 { font-size: 10pt; margin: 12px 0 4px; }
  </style>
</head>
<body>
  <h1>{{ resume.contact.full_name or 'Candidate' }}</h1>
  <p>{{ resume.contact.email or '' }}</p>
  {% if resume.skills %}<h2>Skills</h2><p>{{ resume.skills | join(', ') }}</p>{% endif %}
  {% if resume.experience %}
  <h2>Experience</h2>
  {% for exp in resume.experience %}
  <p>{{ exp.title }} — {{ exp.company }}</p>
  {% endfor %}
  {% endif %}
</body>
</html>
