# Copy to .env and adjust for local development:
#   cp .env.example .env
#
# These defaults match docker/docker-compose.yml for Postgres/Redis.
# Provider keys are placeholders only — never commit real secrets.

# PostgreSQL (used by Compose variable substitution)
POSTGRES_USER=career
POSTGRES_PASSWORD=career
POSTGRES_DB=career_agent

# Application connection strings
DATABASE_URL=postgresql://career:career@localhost:5433/career_agent
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Auth — Supabase Auth (default AuthProvider)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Backend verifies Supabase access tokens via JWKS at:
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Do not use SUPABASE_JWT_SECRET (removed from this project's assumptions).
# SUPABASE_JWT_SECRET=

# Frontend (apps/web) — public anon key only; never put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the FastAPI backend (NOT the Supabase project URL).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Comma-separated origins allowed to call the API from the browser.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# LLM — Groq or Gemini behind LLMProvider (structured extraction)
# ---------------------------------------------------------------------------
# Which adapter to use: groq | gemini
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Object storage — Supabase Storage (default StorageProvider)
# ---------------------------------------------------------------------------
# Create a private bucket in Supabase Storage (e.g. "resumes").
# The API uses SUPABASE_SERVICE_ROLE_KEY server-side; clients receive signed URLs.
# Do not set SUPABASE_JWT_SECRET for storage access.
SUPABASE_STORAGE_BUCKET=resumes
# Optional public URL base for constructing object URLs (only if bucket is public).
# For a private bucket, reads should use signed URLs generated server-side; leave blank.
SUPABASE_STORAGE_PUBLIC_URL=

# Optional / legacy StorageProvider alternative (Cloudflare R2, S3-compatible):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=
# Optional public/CDN base URL for read access
# R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Web scraping — self-hosted Firecrawl (ScraperProvider)
# Point at your own instance; do not assume Firecrawl cloud.
# ---------------------------------------------------------------------------
FIRECRAWL_BASE_URL=http://localhost:3002
# Optional if your self-hosted instance enforces an API key
FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------------
# Web search — Tavily (SearchProvider)
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# People / email enrichment (optional; CI uses mocks)
# ---------------------------------------------------------------------------
# ApolloPeopleProvider — leave blank to use MockPeopleProvider
APOLLO_API_KEY=
# HunterEmailFinderProvider / HunterEmailVerifierProvider — leave blank for mocks
HUNTER_API_KEY=

# ---------------------------------------------------------------------------
# Outbound email — EmailSenderProvider (Resend default; mock when unset)
# ---------------------------------------------------------------------------
# ResendEmailSenderProvider — leave blank to use MockEmailSenderProvider in CI.
RESEND_API_KEY=
# Verified sender in Resend (e.g. onboarding@resend.dev for sandbox testing)
RESEND_FROM_EMAIL=
#
# Optional SMTP fallback (local Mailhog / self-hosted) when RESEND_API_KEY is unset:
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# SMTP_FROM_EMAIL=noreply@localhost
#
# Optional Amazon SES stub — NOT required; needs verified domain (intervention):
# SES_ENABLED=false
# SES_REGION=
# SES_FROM_EMAIL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# MailboxProvider (Gmail/Outlook) — mock/stub only; OAuth not required for CI
# ---------------------------------------------------------------------------
# Optional key for encrypting stored OAuth tokens (dev has a deterministic fallback):
# MAILBOX_TOKEN_ENCRYPTION_KEY=
